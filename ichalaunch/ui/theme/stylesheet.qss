/* IchaLaunch — RavenCraft theme (ravencraft.io) */

* {
    font-family: "Segoe UI", "Candara", "Calibri", sans-serif;
}

/* Chrome only. Cinzel is bundled (see ui/theme_fonts.py); the rest of the
   stack is what the launcher fell back to before it was, so a build without
   the font files still renders the way it used to. Body copy, mod and addon
   rows and tooltips deliberately stay on the sans stack above. */
QLabel#SectionTitle,
QLabel#CardTitle,
QLabel#Subtitle,
QLabel#HomeModCategory,
QLabel#SectionSubtitle,
QLabel#HomeModCategorySub,
QLabel#ThemedDialogTitle,
QLabel#CountdownTitle {
    font-family: "__CHROME_FAMILY__", "Segoe UI", "Candara", "Calibri", serif;
}

QMainWindow {
    background: transparent;
}

QWidget#Root {
    /* Transparent host — FolderFrameStroke paints metal rails/corners.
       TopNavStrip / ContentPanel / BottomBar carry the fills. */
    background-color: transparent;
    color: #ece3d2;
    border: none;
    border-radius: 0;
}

QLabel#Brand {
    color: #F1C22D;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#Subtitle {
    color: #a8977c;
    font-size: 13px;
}

QLabel#SectionTitle {
    color: #F1C22D;
    font-size: 16px;
    font-weight: 600;
}

/* The quieter half of a title lockup: same face, smaller, and stepped down in
   colour so it reads as a qualifier rather than a second heading. */
QLabel#SectionSubtitle {
    color: rgba(241, 194, 45, 0.55);
    font-size: 13px;
    font-weight: 400;
    padding-bottom: 2px;
}

QLabel#HomeModCategorySub {
    color: rgba(241, 194, 45, 0.85);
    font-size: 15px;
    font-weight: 400;
}

QLabel#Muted {
    color: #a8977c;
}

QLabel#AddonDownloadCountLabel {
    color: #C4A35A;
    font-size: 11px;
    font-weight: 600;
}

QFrame#Card, QFrame.Card {
    background-color: #1b1512;
    border: 1px solid rgba(201, 149, 63, 0.28);
    border-radius: 10px;
}

/* Installed-mods panel — opaque base; DarkForest art painted in HomeModsCard. */
QFrame#HomeModsCard {
    background-color: #1b1512;
    border: 1px solid rgba(201, 149, 63, 0.28);
    border-radius: 10px;
}

QLabel#CardTitle {
    color: #F1C22D;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QPushButton {
    background-color: #2e2820;
    color: #ece3d2;
    border: 1px solid #94836a;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #6b4a1e;
    border-color: #c9953f;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #4a3314;
    border-color: #F1C22D;
}

/* Play / Install / Update — painted by LaunchButton (chrome PNG + gold label).
   Keep QSS transparent so the custom paintEvent is not overridden. */
QPushButton#PlayButton {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: transparent;
}

QPushButton#PlayButton:hover,
QPushButton#PlayButton:pressed,
QPushButton#PlayButton:disabled {
    background: transparent;
    border: none;
    color: transparent;
}

/* Eye-catching Update / Update All / Apply-when-pending (RavenCraft purple primary) */
QPushButton#UpdateButton,
QPushButton#UpdateButtonLead,
QPushButton#UpdateAllButton,
QPushButton#ApplyReadyButton,
QPushButton#ApplyReadyButtonPulse {
    background-color: #6b4a1e;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 22px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

QPushButton#UpdateButton:hover,
QPushButton#UpdateButtonLead:hover,
QPushButton#UpdateAllButton:hover,
QPushButton#ApplyReadyButton:hover,
QPushButton#ApplyReadyButtonPulse:hover {
    background-color: #c9953f;
    border-color: #FF7757;
    color: #ffffff;
}

QPushButton#UpdateButton:pressed,
QPushButton#UpdateButtonLead:pressed,
QPushButton#UpdateAllButton:pressed,
QPushButton#ApplyReadyButton:pressed,
QPushButton#ApplyReadyButtonPulse:pressed {
    background-color: #4a3314;
    border-color: #F1C22D;
}

QPushButton#UpdateButton:disabled,
QPushButton#UpdateButtonLead:disabled,
QPushButton#UpdateAllButton:disabled {
    background-color: #2a2428;
    color: #666;
    border-color: rgba(163, 140, 106, 0.2);
}

QPushButton#UpdateButton {
    background-color: #6b4a1e;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-radius: 8px;
    padding: 4px 12px;
    min-height: 22px;
    font-weight: 700;
}

QPushButton#UpdateButtonLead {
    background-color: #6b4a1e;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-right: none;
    padding: 4px 12px;
    min-height: 22px;
    font-weight: 700;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

/* Row secondary actions — opaque fills (rgba disappears on translucent MainWindow).
   OpenGitButton is icon-only (custom paint + Fixed hit box); do NOT give it text-button
   min-width/padding or the glyph sits ~40px away from the name with empty chrome. */
QPushButton#ReinstallButton,
QPushButton#InstallButton,
QPushButton#RemoveButton {
    background-color: #2e2820;
    color: #ece3d2;
    border: 1px solid #94836a;
    border-radius: 8px;
    padding: 4px 12px;
    min-height: 22px;
    font-size: 13px;
}

QPushButton#ReinstallButton:hover,
QPushButton#InstallButton:hover,
QPushButton#RemoveButton:hover {
    background-color: #6b4a1e;
    border-color: #c9953f;
    color: #ffffff;
}

QPushButton#ReinstallButton:pressed,
QPushButton#InstallButton:pressed,
QPushButton#RemoveButton:pressed {
    background-color: #4a3314;
    border-color: #F1C22D;
}

QPushButton#ReinstallButton {
    background-color: #2e2820;
    color: #ece3d2;
    border: 1px solid #94836a;
    border-radius: 8px;
    padding: 4px 12px;
    min-width: 100px;
    min-height: 22px;
}

/* Icon-only Open in Git / Open link — override global QPushButton padding. */
QPushButton#OpenGitButton {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
    min-height: 0;
    color: transparent;
}

QPushButton#InstallButton,
QPushButton#RemoveButton {
    background-color: #2e2820;
    color: #ece3d2;
    border: 1px solid #94836a;
    border-radius: 8px;
    padding: 4px 12px;
    min-width: 72px;
    min-height: 22px;
}

/* Caret is a QPushButton (not InstantPopup QToolButton) to avoid orphan popup flashes. */
QPushButton#UpdateMenuButton {
    background-color: #6b4a1e;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-left: none;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 4px 6px;
    min-width: 22px;
    min-height: 22px;
    font-weight: 700;
}

QPushButton#UpdateMenuButton:hover {
    background-color: #c9953f;
    border-color: #FF7757;
}

/* Gold border pulse when Apply Changes has pending installs/removes */
QPushButton#ApplyReadyButtonPulse {
    border: 2px solid #FFD966;
    background-color: #5a3a90;
}

/* Folder-tab strip — gutters transparent; glue plates painted in NavTabButton */
QWidget#TopNav {
    background: transparent;
    border: none;
}

QPushButton#TopNavButton {
    text-align: center;
    /* Extra top / less bottom so labels sit higher in the tab shape */
    padding: 10px 18px 4px 18px;
    margin: 2px 0 0 0;
    border: none;
    outline: none;
    background-color: transparent;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: transparent;
    min-width: 92px;
    min-height: 28px;
}

QPushButton#TopNavButton:hover,
QPushButton#TopNavButton:pressed,
QPushButton#TopNavButton:focus {
    color: transparent;
    background-color: transparent;
    border: none;
    outline: none;
}

/* Selected: slightly taller plate; gold label is painted in NavTabButton */
QPushButton#TopNavButton:checked {
    color: transparent;
    background-color: transparent;
    border: none;
    outline: none;
    margin-top: 0;
    padding-top: 12px;
    padding-bottom: 6px;
    min-height: 32px;
}

/* Folder body — floor in ContentPanel.paintEvent.
   Metal chrome via FolderFrameStroke (not QSS). */
QWidget#ContentPanel {
    background-color: transparent;
    border: none;
    border-radius: 0;
}

/* RavenCraft nav strip — PNG via NavBottomBanner; fills via NavBannerUnderFill. */
QWidget#NavBottomBanner,
QWidget#NavBannerUnderFill {
    background-color: transparent;
    border: none;
}

/* Play strip — mist in BottomBar.paintEvent; metal rails via FolderFrameStroke. */
QWidget#BottomBar {
    background-color: transparent;
    border: none;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

/* Opaque base in QSS; marble tiles painted in MarblePanel.paintEvent (flush to stroke). */
QWidget#ClientCatNav,
QWidget#AddonsWindow {
    background-color: #1b1512;
    border: 1px solid rgba(201, 149, 63, 0.30);
    border-radius: 10px;
    padding: 0;
}

QWidget#SettingsHost,
QWidget#ClientCatPanel,
QWidget#ClientCatHost,
QStackedWidget#ClientCatStack {
    background: transparent;
    color: #ece3d2;
}

/* Settings: let ContentPanel Necrolord floor show through (same as Home/Addons).
   Client category scroll keeps a subtle framed panel. */
QScrollArea#SettingsScroll {
    background: transparent;
    border: none;
}

/* Opaque base in QSS; marble tiles painted on the scroll frame (flush to stroke). */
QScrollArea#ClientCatScroll {
    background-color: #1b1512;
    border: 1px solid rgba(163, 140, 106, 0.18);
    border-radius: 10px;
    padding: 0;
}

QScrollArea#SettingsScroll > QWidget > QWidget,
QScrollArea#ClientCatScroll > QWidget > QWidget {
    background: transparent;
}

QScrollArea#SettingsScroll QWidget#qt_scrollarea_viewport,
QScrollArea#ClientCatScroll QWidget#qt_scrollarea_viewport {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QWidget#HomeBrandPane {
    background-color: transparent;
}

QWidget#HomeModsDrawer {
    background-color: transparent;
}

QWidget#HomeModsHost {
    background-color: transparent;
}

/* The category band. The shading and the rules live on the row, not on the
   labels, so the heading and its count sit inside one block however the heading
   wraps. Categories were previously separated by colour and spacing alone, which
   does not survive a glance down the list. */
QFrame#HomeModCategoryRow {
    background-color: rgba(241, 194, 45, 0.07);
    border-top: 1px solid rgba(241, 194, 45, 0.30);
    border-bottom: 1px solid rgba(241, 194, 45, 0.15);
    margin-top: 6px;
    margin-bottom: 4px;
}

/* On the chrome face, like the tabs and the site's own headings. The earlier
   attempt at this failed because it was tried at 30px, where the two longest
   category names are wider than a 320px drawer and were painted under the
   scrollbar. The face was never the problem, the size was. At 18px the longest
   name and its count sit on one line with room to spare, and the panel stops
   disagreeing with both the site and the rest of the launcher. */
QLabel#HomeModCategory {
    color: #F1C22D;
    font-size: 18px;
    font-weight: 600;
    background: transparent;
    border: none;
}

/* The count rides the heading's row, right aligned, in the same gold. No second
   typographic voice, so it reads as a property of the category rather than as an
   orphaned line. Contrast against the band is 8.6:1, past the 7:1 that counts as
   AAA; the grey it replaced scored 3.91 and failed AA outright. */
QLabel#HomeModCategoryCount {
    color: rgba(241, 194, 45, 0.88);
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: none;
    padding-right: 2px;
}

QLabel#HomeModItem {
    color: #ece3d2;
    font-size: 13px;
    padding-left: 14px;
}

QPushButton#CatNavButton {
    text-align: left;
    padding: 12px 14px;
    border: none;
    border-radius: 8px;
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #a8977c;
}

QPushButton#CatNavButton:hover {
    background-color: rgba(201, 149, 63, 0.16);
    color: #ece3d2;
    border-radius: 8px;
}

QPushButton#CatNavButton:checked {
    background-color: rgba(107, 74, 30, 0.35);
    color: #F1C22D;
    border-left: 3px solid #F1C22D;
    border-radius: 8px;
}

/* Light wash so ClientCatScroll marble shows through row gaps / edges. */
QWidget#ModCheckRow {
    background-color: rgba(150, 122, 78, 0.045);
    border: 1px solid rgba(163, 140, 106, 0.14);
    border-radius: 8px;
}

QWidget#ModCheckRow[flashHighlight="true"] {
    background-color: rgba(241, 194, 45, 0.16);
    border: 1px solid #F1C22D;
}

QLabel#UpdateAlertBadge {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

QLabel#ModRowName {
    color: #ece3d2;
    font-weight: 600;
}

QPushButton#DescToggle {
    border: none;
    background: transparent;
    color: #a8977c;
    padding: 0;
    min-width: 18px;
}

QPushButton#DescToggle:hover {
    color: #F1C22D;
    background: transparent;
}

QPushButton#DescToggle:pressed {
    color: #c9953f;
    background: transparent;
}

QLabel#StatusMuted {
    color: #a8977c;
}

QLabel#StatusOk {
    color: #c9953f;
}

QLabel#StatusUpdate {
    color: #F1C22D;
}

QLabel#StatusWarning {
    color: #E8A54B;
}

QProgressBar#BottomProgress {
    background-color: transparent;
    border: none;
    min-height: 28px;
}

/* Legacy chunk styles unused by ThemeLoadingBar; kept harmless if QProgressBar returns. */
QProgressBar#BottomProgress::chunk {
    background-color: #c9953f;
    border-radius: 3px;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: rgba(150, 122, 78, 0.10);
    color: #ece3d2;
    border: 1px solid rgba(163, 140, 106, 0.18);
    border-radius: 8px;
    padding: 8px;
    min-height: 20px;
    selection-background-color: #c9953f;
}

QLineEdit:hover {
    border-color: rgba(201, 149, 63, 0.55);
}

QLineEdit:focus {
    border-color: #F1C22D;
}

/* CastingBarSearchEdit — chrome painted in Python (CastingBar border). */
QLineEdit#CastingBarSearch,
QLineEdit#ClientSearch,
QLineEdit#SettingsGamePath,
QLineEdit#SettingsAddonsPath,
QLineEdit#SettingsGithubToken {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    color: #ece3d2;
}

QLineEdit#CastingBarSearch:hover,
QLineEdit#CastingBarSearch:focus,
QLineEdit#ClientSearch:hover,
QLineEdit#ClientSearch:focus,
QLineEdit#SettingsGamePath:hover,
QLineEdit#SettingsGamePath:focus,
QLineEdit#SettingsAddonsPath:hover,
QLineEdit#SettingsAddonsPath:focus,
QLineEdit#SettingsGithubToken:hover,
QLineEdit#SettingsGithubToken:focus {
    background: transparent;
    border: none;
}

QComboBox {
    background-color: rgba(150, 122, 78, 0.10);
    color: #ece3d2;
    border: 1px solid rgba(163, 140, 106, 0.18);
    border-radius: 8px;
    /* Match GluePanelButton / GlueComboBox (GLUE_BTN_H = 34). */
    padding: 0 32px 0 10px;
    min-height: 34px;
    max-height: 34px;
    selection-background-color: #c9953f;
}

QComboBox:hover {
    border-color: #F1C22D;
}

QComboBox:on {
    border-color: #F1C22D;
    background-color: rgba(201, 149, 63, 0.18);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(__CHEVRON_DOWN__);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #100d0c;
    color: #ece3d2;
    border: 1px solid rgba(163, 140, 106, 0.2);
    border-radius: 8px;
    outline: none;
    padding: 4px;
    selection-background-color: #6b4a1e;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
}

/* ThemeCheckBox is QAbstractButton — paint owns the indicator; no QCheckBox::indicator hover. */
QAbstractButton#ThemeCheckBox {
    background: transparent;
    border: none;
    color: #ece3d2;
    min-height: 28px;
    padding: 0;
    margin: 0;
    spacing: 0;
}

/* ThemeRadioButton / preset radios — same paint-owned indicator pattern. */
QAbstractButton#ThemeRadioButton,
QAbstractButton#ThemePresetRadio {
    background: transparent;
    border: none;
    color: #ece3d2;
    min-height: 28px;
    padding: 0;
    margin: 0;
    spacing: 0;
}

/* Legacy QCheckBox rules kept harmless if any remain. */
QCheckBox {
    spacing: 10px;
    color: #ece3d2;
    min-height: 28px;
    padding: 2px 0 2px 0;
    margin: 0;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: none;
    background: transparent;
}

QProgressBar {
    background-color: rgba(150, 122, 78, 0.10);
    border: 1px solid rgba(163, 140, 106, 0.15);
    border-radius: 4px;
    text-align: center;
    color: #ece3d2;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #F1C22D;
    border-radius: 3px;
}

QScrollArea,
QAbstractScrollArea {
    border: none;
    background: transparent;
}

QAbstractScrollArea::viewport {
    background: transparent;
}

/* RavenCraft scrollbars — thin dark track, purple thumb, gold on hover */
QScrollBar:vertical {
    background: #1b1512;
    width: 9px;
    margin: 2px 1px 2px 1px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #6b4a1e;
    border: 1px solid rgba(241, 194, 45, 0.25);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #c9953f;
    border-color: #F1C22D;
}

QScrollBar::handle:vertical:pressed {
    background: #F1C22D;
    border-color: #F1C22D;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #1b1512;
    height: 9px;
    margin: 1px 2px 1px 2px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #6b4a1e;
    border: 1px solid rgba(241, 194, 45, 0.25);
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #c9953f;
    border-color: #F1C22D;
}

QScrollBar::handle:horizontal:pressed {
    background: #F1C22D;
    border-color: #F1C22D;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QListWidget, QTreeWidget, QTableWidget {
    background-color: #1b1512;
    border: 1px solid rgba(201, 149, 63, 0.25);
    border-radius: 8px;
    color: #ece3d2;
    outline: none;
    padding: 4px;
}

/* Addon lists — viewport transparent so MarbleListWidget can tile marble.
   padding:0 so marble meets the purple stroke (global QListWidget has 4px pad). */
QListWidget#MarbleList {
    background-color: #1b1512;
    padding: 0;
    border: 1px solid rgba(201, 149, 63, 0.25);
    border-radius: 8px;
}

QListWidget#MarbleList QWidget#qt_scrollarea_viewport {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QListWidget::item, QTreeWidget::item {
    padding: 4px 6px;
    border-radius: 6px;
    color: #ece3d2;
    background: transparent;
}

/* Soft hover — avoid opaque item fills that fight marble + item widgets. */
QListWidget#MarbleList::item:hover {
    background-color: rgba(201, 149, 63, 0.10);
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: rgba(201, 149, 63, 0.18);
}

QListWidget#MarbleList::item:selected {
    background-color: rgba(107, 74, 30, 0.35);
    color: #ffffff;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #6b4a1e;
    color: #ffffff;
}

QStatusBar {
    background-color: #100d0c;
    color: #a8977c;
    border-top: 1px solid rgba(163, 140, 106, 0.15);
}

QTabWidget::pane {
    border: 1px solid rgba(163, 140, 106, 0.15);
    background: rgba(150, 122, 78, 0.06);
}

QTabBar::tab {
    background: rgba(150, 122, 78, 0.10);
    color: #a8977c;
    padding: 8px 16px;
    border: 1px solid rgba(163, 140, 106, 0.15);
    border-bottom: none;
}

QTabBar::tab:selected {
    color: #F1C22D;
    background: #1b1512;
}

QMessageBox {
    background-color: #100d0c;
}

/* Themed modal dialogs (frameless RavenCraft cards) */
QDialog#ThemedDialog {
    background: transparent;
}

QWidget#ThemedDialogCard {
    background-color: #100d0c;
    border: 1px solid rgba(163, 140, 106, 0.22);
    border-radius: 10px;
}

QLabel#ThemedDialogTitle {
    color: #F1C22D;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#ThemedDialogBody {
    color: #ece3d2;
    font-size: 13px;
    line-height: 1.35;
}

QLabel#ThemedDialogSection {
    color: #F1C22D;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

QLabel#ThemedDialogHint {
    color: #7a6e58;
    font-size: 12px;
    line-height: 1.35;
}

QSpinBox, QDoubleSpinBox {
    background-color: rgba(150, 122, 78, 0.10);
    color: #ece3d2;
    border: 1px solid rgba(163, 140, 106, 0.18);
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 22px;
    selection-background-color: #c9953f;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: rgba(201, 149, 63, 0.55);
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #F1C22D;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #7a6e58;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: rgba(150, 122, 78, 0.18);
    border: none;
    width: 16px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: rgba(163, 140, 106, 0.22);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #c9953f;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #F1C22D;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffd45a;
}

QSlider:disabled {
    opacity: 0.45;
}

QPushButton#ThemedDialogPrimary {
    background-color: #6b4a1e;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    min-width: 72px;
}

QPushButton#ThemedDialogPrimary:hover {
    background-color: #c9953f;
    border-color: #FF7757;
}

QPushButton#ThemedDialogSecondary {
    background-color: rgba(150, 122, 78, 0.10);
    color: #ece3d2;
    border: 1px solid rgba(163, 140, 106, 0.18);
    border-radius: 8px;
    padding: 8px 18px;
    min-width: 72px;
}

QPushButton#ThemedDialogSecondary:hover {
    background-color: rgba(201, 149, 63, 0.22);
    border-color: #c9953f;
}

/* Launch countdown (ravencraft.io) */
QWidget#LaunchCountdown QLabel#CountdownTitle {
    color: #a8977c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

QFrame#CountCell {
    background-color: rgba(150, 122, 78, 0.08);
    border: 1px solid rgba(163, 140, 106, 0.15);
    border-radius: 10px;
}

QLabel#CountNum {
    color: #F1C22D;
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
}

QLabel#CountLabel {
    color: #a8977c;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#CountdownLive {
    color: #F1C22D;
    font-size: 16px;
    font-weight: 700;
}

