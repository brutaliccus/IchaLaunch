/* IchaLaunch — RavenCraft theme (ravencraft.io) */

* {
    font-family: "Segoe UI", "Candara", "Calibri", sans-serif;
}

QMainWindow {
    background: transparent;
}

QWidget#Root {
    /* Transparent host — FolderFrameStroke paints metal rails/corners.
       TopNavStrip / ContentPanel / BottomBar carry the fills. */
    background-color: transparent;
    color: #e6e0ee;
    border: none;
    border-radius: 0;
}

QLabel#Brand {
    color: #F1C22D;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#Subtitle {
    color: #9990ab;
    font-size: 13px;
}

QLabel#SectionTitle {
    color: #F1C22D;
    font-size: 16px;
    font-weight: 600;
}

QLabel#Muted {
    color: #9990ab;
}

QLabel#AddonDownloadCountLabel {
    color: #C4A35A;
    font-size: 11px;
    font-weight: 600;
}

QFrame#Card, QFrame.Card {
    background-color: #181315;
    border: 1px solid rgba(124, 92, 196, 0.28);
    border-radius: 10px;
}

/* Installed-mods panel — opaque base; DarkForest art painted in HomeModsCard. */
QFrame#HomeModsCard {
    background-color: #181315;
    border: 1px solid rgba(124, 92, 196, 0.28);
    border-radius: 10px;
}

QLabel#CardTitle {
    color: #F1C22D;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QPushButton {
    background-color: #2c2632;
    color: #e6e0ee;
    border: 1px solid #7a6e88;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #4a2f7a;
    border-color: #7c5cc4;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #3a2460;
    border-color: #F1C22D;
}

/* Play / Install / Update — painted by LaunchButton (chrome PNG + gold label).
   Keep QSS transparent so the custom paintEvent is not overridden. */
QPushButton#PlayButton {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: transparent;
}

QPushButton#PlayButton:hover,
QPushButton#PlayButton:pressed,
QPushButton#PlayButton:disabled {
    background: transparent;
    border: none;
    color: transparent;
}

/* Eye-catching Update / Update All / Apply-when-pending (RavenCraft purple primary) */
QPushButton#UpdateButton,
QPushButton#UpdateButtonLead,
QPushButton#UpdateAllButton,
QPushButton#ApplyReadyButton,
QPushButton#ApplyReadyButtonPulse {
    background-color: #4a2f7a;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 22px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

QPushButton#UpdateButton:hover,
QPushButton#UpdateButtonLead:hover,
QPushButton#UpdateAllButton:hover,
QPushButton#ApplyReadyButton:hover,
QPushButton#ApplyReadyButtonPulse:hover {
    background-color: #7c5cc4;
    border-color: #FF7757;
    color: #ffffff;
}

QPushButton#UpdateButton:pressed,
QPushButton#UpdateButtonLead:pressed,
QPushButton#UpdateAllButton:pressed,
QPushButton#ApplyReadyButton:pressed,
QPushButton#ApplyReadyButtonPulse:pressed {
    background-color: #3a2460;
    border-color: #F1C22D;
}

QPushButton#UpdateButton:disabled,
QPushButton#UpdateButtonLead:disabled,
QPushButton#UpdateAllButton:disabled {
    background-color: #2a2428;
    color: #666;
    border-color: rgba(150, 131, 158, 0.2);
}

QPushButton#UpdateButton {
    background-color: #4a2f7a;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-radius: 8px;
    padding: 4px 12px;
    min-height: 22px;
    font-weight: 700;
}

QPushButton#UpdateButtonLead {
    background-color: #4a2f7a;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-right: none;
    padding: 4px 12px;
    min-height: 22px;
    font-weight: 700;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

/* Row secondary actions — opaque fills (rgba disappears on translucent MainWindow).
   OpenGitButton is icon-only (custom paint + Fixed hit box); do NOT give it text-button
   min-width/padding or the glyph sits ~40px away from the name with empty chrome. */
QPushButton#ReinstallButton,
QPushButton#InstallButton,
QPushButton#RemoveButton {
    background-color: #2c2632;
    color: #e6e0ee;
    border: 1px solid #7a6e88;
    border-radius: 8px;
    padding: 4px 12px;
    min-height: 22px;
    font-size: 13px;
}

QPushButton#ReinstallButton:hover,
QPushButton#InstallButton:hover,
QPushButton#RemoveButton:hover {
    background-color: #4a2f7a;
    border-color: #7c5cc4;
    color: #ffffff;
}

QPushButton#ReinstallButton:pressed,
QPushButton#InstallButton:pressed,
QPushButton#RemoveButton:pressed {
    background-color: #3a2460;
    border-color: #F1C22D;
}

QPushButton#ReinstallButton {
    background-color: #2c2632;
    color: #e6e0ee;
    border: 1px solid #7a6e88;
    border-radius: 8px;
    padding: 4px 12px;
    min-width: 100px;
    min-height: 22px;
}

/* Icon-only Open in Git / Open link — override global QPushButton padding. */
QPushButton#OpenGitButton {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
    min-height: 0;
    color: transparent;
}

QPushButton#InstallButton,
QPushButton#RemoveButton {
    background-color: #2c2632;
    color: #e6e0ee;
    border: 1px solid #7a6e88;
    border-radius: 8px;
    padding: 4px 12px;
    min-width: 72px;
    min-height: 22px;
}

/* Caret is a QPushButton (not InstantPopup QToolButton) to avoid orphan popup flashes. */
QPushButton#UpdateMenuButton {
    background-color: #4a2f7a;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-left: none;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 4px 6px;
    min-width: 22px;
    min-height: 22px;
    font-weight: 700;
}

QPushButton#UpdateMenuButton:hover {
    background-color: #7c5cc4;
    border-color: #FF7757;
}

/* Gold border pulse when Apply Changes has pending installs/removes */
QPushButton#ApplyReadyButtonPulse {
    border: 2px solid #FFD966;
    background-color: #5a3a90;
}

/* Folder-tab strip — gutters transparent; glue plates painted in NavTabButton */
QWidget#TopNav {
    background: transparent;
    border: none;
}

QPushButton#TopNavButton {
    text-align: center;
    /* Extra top / less bottom so labels sit higher in the tab shape */
    padding: 10px 18px 4px 18px;
    margin: 2px 0 0 0;
    border: none;
    outline: none;
    background-color: transparent;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: transparent;
    min-width: 92px;
    min-height: 28px;
}

QPushButton#TopNavButton:hover,
QPushButton#TopNavButton:pressed,
QPushButton#TopNavButton:focus {
    color: transparent;
    background-color: transparent;
    border: none;
    outline: none;
}

/* Selected: slightly taller plate; gold label is painted in NavTabButton */
QPushButton#TopNavButton:checked {
    color: transparent;
    background-color: transparent;
    border: none;
    outline: none;
    margin-top: 0;
    padding-top: 12px;
    padding-bottom: 6px;
    min-height: 32px;
}

/* Folder body — floor in ContentPanel.paintEvent.
   Metal chrome via FolderFrameStroke (not QSS). */
QWidget#ContentPanel {
    background-color: transparent;
    border: none;
    border-radius: 0;
}

/* RavenCraft nav strip — PNG via NavBottomBanner; fills via NavBannerUnderFill. */
QWidget#NavBottomBanner,
QWidget#NavBannerUnderFill {
    background-color: transparent;
    border: none;
}

/* Play strip — mist in BottomBar.paintEvent; metal rails via FolderFrameStroke. */
QWidget#BottomBar {
    background-color: transparent;
    border: none;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

/* Opaque base in QSS; marble tiles painted in MarblePanel.paintEvent (flush to stroke). */
QWidget#ClientCatNav,
QWidget#AddonsWindow {
    background-color: #181315;
    border: 1px solid rgba(124, 92, 196, 0.30);
    border-radius: 10px;
    padding: 0;
}

QWidget#SettingsHost,
QWidget#ClientCatPanel,
QWidget#ClientCatHost,
QStackedWidget#ClientCatStack {
    background: transparent;
    color: #e6e0ee;
}

/* Settings: let ContentPanel Necrolord floor show through (same as Home/Addons).
   Client category scroll keeps a subtle framed panel. */
QScrollArea#SettingsScroll {
    background: transparent;
    border: none;
}

/* Opaque base in QSS; marble tiles painted on the scroll frame (flush to stroke). */
QScrollArea#ClientCatScroll {
    background-color: #181315;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 10px;
    padding: 0;
}

QScrollArea#SettingsScroll > QWidget > QWidget,
QScrollArea#ClientCatScroll > QWidget > QWidget {
    background: transparent;
}

QScrollArea#SettingsScroll QWidget#qt_scrollarea_viewport,
QScrollArea#ClientCatScroll QWidget#qt_scrollarea_viewport {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QWidget#HomeBrandPane {
    background-color: transparent;
}

QWidget#HomeModsDrawer {
    background-color: transparent;
}

QWidget#HomeModsHost {
    background-color: transparent;
}

QLabel#HomeModCategory {
    color: #F1C22D;
    font-size: 12px;
    font-weight: 600;
}

QLabel#HomeModItem {
    color: #e6e0ee;
    font-size: 13px;
}

QPushButton#CatNavButton {
    text-align: left;
    padding: 12px 14px;
    border: none;
    border-radius: 8px;
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #9990ab;
}

QPushButton#CatNavButton:hover {
    background-color: rgba(124, 92, 196, 0.16);
    color: #e6e0ee;
    border-radius: 8px;
}

QPushButton#CatNavButton:checked {
    background-color: rgba(74, 47, 122, 0.35);
    color: #F1C22D;
    border-left: 3px solid #F1C22D;
    border-radius: 8px;
}

/* Light wash so ClientCatScroll marble shows through row gaps / edges. */
QWidget#ModCheckRow {
    background-color: rgba(120, 100, 150, 0.045);
    border: 1px solid rgba(150, 131, 158, 0.14);
    border-radius: 8px;
}

QWidget#ModCheckRow[flashHighlight="true"] {
    background-color: rgba(241, 194, 45, 0.16);
    border: 1px solid #F1C22D;
}

QLabel#UpdateAlertBadge {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

QLabel#ModRowName {
    color: #e6e0ee;
    font-weight: 600;
}

QPushButton#DescToggle {
    border: none;
    background: transparent;
    color: #9990ab;
    padding: 0;
    min-width: 18px;
}

QPushButton#DescToggle:hover {
    color: #F1C22D;
    background: transparent;
}

QPushButton#DescToggle:pressed {
    color: #7c5cc4;
    background: transparent;
}

QLabel#StatusMuted {
    color: #9990ab;
}

QLabel#StatusOk {
    color: #7c5cc4;
}

QLabel#StatusUpdate {
    color: #F1C22D;
}

QLabel#StatusWarning {
    color: #E8A54B;
}

QProgressBar#BottomProgress {
    background-color: transparent;
    border: none;
    min-height: 28px;
}

/* Legacy chunk styles unused by ThemeLoadingBar; kept harmless if QProgressBar returns. */
QProgressBar#BottomProgress::chunk {
    background-color: #7c5cc4;
    border-radius: 3px;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 8px;
    padding: 8px;
    min-height: 20px;
    selection-background-color: #7c5cc4;
}

QLineEdit:hover {
    border-color: rgba(124, 92, 196, 0.55);
}

QLineEdit:focus {
    border-color: #F1C22D;
}

/* CastingBarSearchEdit — chrome painted in Python (CastingBar border). */
QLineEdit#CastingBarSearch,
QLineEdit#ClientSearch,
QLineEdit#SettingsGamePath,
QLineEdit#SettingsAddonsPath,
QLineEdit#SettingsGithubToken {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    color: #e6e0ee;
}

QLineEdit#CastingBarSearch:hover,
QLineEdit#CastingBarSearch:focus,
QLineEdit#ClientSearch:hover,
QLineEdit#ClientSearch:focus,
QLineEdit#SettingsGamePath:hover,
QLineEdit#SettingsGamePath:focus,
QLineEdit#SettingsAddonsPath:hover,
QLineEdit#SettingsAddonsPath:focus,
QLineEdit#SettingsGithubToken:hover,
QLineEdit#SettingsGithubToken:focus {
    background: transparent;
    border: none;
}

QComboBox {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 8px;
    /* Match GluePanelButton / GlueComboBox (GLUE_BTN_H = 34). */
    padding: 0 32px 0 10px;
    min-height: 34px;
    max-height: 34px;
    selection-background-color: #7c5cc4;
}

QComboBox:hover {
    border-color: #F1C22D;
}

QComboBox:on {
    border-color: #F1C22D;
    background-color: rgba(124, 92, 196, 0.18);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(__CHEVRON_DOWN__);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #100d0c;
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.2);
    border-radius: 8px;
    outline: none;
    padding: 4px;
    selection-background-color: #4a2f7a;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
}

/* ThemeCheckBox is QAbstractButton — paint owns the indicator; no QCheckBox::indicator hover. */
QAbstractButton#ThemeCheckBox {
    background: transparent;
    border: none;
    color: #e6e0ee;
    min-height: 28px;
    padding: 0;
    margin: 0;
    spacing: 0;
}

/* ThemeRadioButton / preset radios — same paint-owned indicator pattern. */
QAbstractButton#ThemeRadioButton,
QAbstractButton#ThemePresetRadio {
    background: transparent;
    border: none;
    color: #e6e0ee;
    min-height: 28px;
    padding: 0;
    margin: 0;
    spacing: 0;
}

/* Legacy QCheckBox rules kept harmless if any remain. */
QCheckBox {
    spacing: 10px;
    color: #e6e0ee;
    min-height: 28px;
    padding: 2px 0 2px 0;
    margin: 0;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: none;
    background: transparent;
}

QProgressBar {
    background-color: rgba(120, 100, 150, 0.10);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 4px;
    text-align: center;
    color: #e6e0ee;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #F1C22D;
    border-radius: 3px;
}

QScrollArea,
QAbstractScrollArea {
    border: none;
    background: transparent;
}

QAbstractScrollArea::viewport {
    background: transparent;
}

/* RavenCraft scrollbars — thin dark track, purple thumb, gold on hover */
QScrollBar:vertical {
    background: #181315;
    width: 9px;
    margin: 2px 1px 2px 1px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #4a2f7a;
    border: 1px solid rgba(241, 194, 45, 0.25);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #7c5cc4;
    border-color: #F1C22D;
}

QScrollBar::handle:vertical:pressed {
    background: #F1C22D;
    border-color: #F1C22D;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #181315;
    height: 9px;
    margin: 1px 2px 1px 2px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #4a2f7a;
    border: 1px solid rgba(241, 194, 45, 0.25);
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #7c5cc4;
    border-color: #F1C22D;
}

QScrollBar::handle:horizontal:pressed {
    background: #F1C22D;
    border-color: #F1C22D;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QListWidget, QTreeWidget, QTableWidget {
    background-color: #181315;
    border: 1px solid rgba(124, 92, 196, 0.25);
    border-radius: 8px;
    color: #e6e0ee;
    outline: none;
    padding: 4px;
}

/* Addon lists — viewport transparent so MarbleListWidget can tile marble.
   padding:0 so marble meets the purple stroke (global QListWidget has 4px pad). */
QListWidget#MarbleList {
    background-color: #181315;
    padding: 0;
    border: 1px solid rgba(124, 92, 196, 0.25);
    border-radius: 8px;
}

QListWidget#MarbleList QWidget#qt_scrollarea_viewport {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QListWidget::item, QTreeWidget::item {
    padding: 4px 6px;
    border-radius: 6px;
    color: #e6e0ee;
    background: transparent;
}

/* Soft hover — avoid opaque item fills that fight marble + item widgets. */
QListWidget#MarbleList::item:hover {
    background-color: rgba(124, 92, 196, 0.10);
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: rgba(124, 92, 196, 0.18);
}

QListWidget#MarbleList::item:selected {
    background-color: rgba(74, 47, 122, 0.35);
    color: #ffffff;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #4a2f7a;
    color: #ffffff;
}

QStatusBar {
    background-color: #100d0c;
    color: #9990ab;
    border-top: 1px solid rgba(150, 131, 158, 0.15);
}

QTabWidget::pane {
    border: 1px solid rgba(150, 131, 158, 0.15);
    background: rgba(120, 100, 150, 0.06);
}

QTabBar::tab {
    background: rgba(120, 100, 150, 0.10);
    color: #9990ab;
    padding: 8px 16px;
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-bottom: none;
}

QTabBar::tab:selected {
    color: #F1C22D;
    background: #181315;
}

QMessageBox {
    background-color: #100d0c;
}

/* Themed modal dialogs (frameless RavenCraft cards) */
QDialog#ThemedDialog {
    background: transparent;
}

QWidget#ThemedDialogCard {
    background-color: #100d0c;
    border: 1px solid rgba(150, 131, 158, 0.22);
    border-radius: 10px;
}

QLabel#ThemedDialogTitle {
    color: #F1C22D;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#ThemedDialogBody {
    color: #e6e0ee;
    font-size: 13px;
    line-height: 1.35;
}

QLabel#ThemedDialogSection {
    color: #F1C22D;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

QLabel#ThemedDialogHint {
    color: #6e6678;
    font-size: 12px;
    line-height: 1.35;
}

QSpinBox, QDoubleSpinBox {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 22px;
    selection-background-color: #7c5cc4;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: rgba(124, 92, 196, 0.55);
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #F1C22D;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #6e6678;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: rgba(120, 100, 150, 0.18);
    border: none;
    width: 16px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: rgba(150, 131, 158, 0.22);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #7c5cc4;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #F1C22D;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffd45a;
}

QSlider:disabled {
    opacity: 0.45;
}

QPushButton#ThemedDialogPrimary {
    background-color: #4a2f7a;
    color: #ffffff;
    border: 1px solid #F1C22D;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    min-width: 72px;
}

QPushButton#ThemedDialogPrimary:hover {
    background-color: #7c5cc4;
    border-color: #FF7757;
}

QPushButton#ThemedDialogSecondary {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 8px;
    padding: 8px 18px;
    min-width: 72px;
}

QPushButton#ThemedDialogSecondary:hover {
    background-color: rgba(124, 92, 196, 0.22);
    border-color: #7c5cc4;
}

/* Launch countdown (ravencraft.io) */
QWidget#LaunchCountdown QLabel#CountdownTitle {
    color: #9990ab;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

QFrame#CountCell {
    background-color: rgba(120, 100, 150, 0.08);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 10px;
}

QLabel#CountNum {
    color: #F1C22D;
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
}

QLabel#CountLabel {
    color: #9990ab;
