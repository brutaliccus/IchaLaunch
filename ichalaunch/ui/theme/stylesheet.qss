/* IchaLaunch — RavenCraft theme (ravencraft.io) */

* {
    font-family: "Segoe UI", "Candara", "Calibri", sans-serif;
}

QMainWindow, QWidget#Root {
    background-color: #181412;
    color: #e6e0ee;
}

QLabel#Brand {
    color: #F1C22D;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#Subtitle {
    color: #9990ab;
    font-size: 13px;
}

QLabel#SectionTitle {
    color: #F1C22D;
    font-size: 16px;
    font-weight: 600;
}

QLabel#Muted {
    color: #9990ab;
}

QFrame#Card, QFrame.Card {
    background-color: rgba(120, 100, 150, 0.08);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 10px;
}

QPushButton {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: rgba(124, 92, 196, 0.22);
    border-color: #7c5cc4;
}

QPushButton:pressed {
    background-color: rgba(74, 47, 122, 0.45);
}

QPushButton#PlayButton {
    background-color: #4a2f7a;
    color: #ffffff;
    border: 2px solid #F1C22D;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
}

QPushButton#PlayButton:hover {
    background-color: #7c5cc4;
    border-color: #FF7757;
}

QPushButton#PlayButton:disabled {
    background-color: #2a2428;
    color: #666;
    border-color: rgba(150, 131, 158, 0.2);
}

QWidget#TitleBar {
    background-color: #100d0c;
    border-bottom: 1px solid rgba(150, 131, 158, 0.15);
}

QWidget#TopNav {
    background-color: #141110;
    border-bottom: 1px solid rgba(150, 131, 158, 0.15);
}

QWidget#BottomBar {
    background-color: #100d0c;
    border-top: 1px solid rgba(150, 131, 158, 0.15);
}

QPushButton#TopNavButton {
    text-align: center;
    padding: 8px 18px;
    border: none;
    border-radius: 0;
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    color: #9990ab;
    min-width: 88px;
}

QPushButton#TopNavButton:hover {
    color: #e6e0ee;
    background-color: rgba(120, 100, 150, 0.10);
}

QPushButton#TopNavButton:checked {
    color: #F1C22D;
    border-bottom: 3px solid #7c5cc4;
    background-color: rgba(120, 100, 150, 0.08);
}

QPushButton#WinBtn, QPushButton#CloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #9990ab;
    font-size: 14px;
    padding: 0;
}

QPushButton#WinBtn:hover {
    background-color: rgba(120, 100, 150, 0.18);
    color: #e6e0ee;
}

QPushButton#CloseBtn:hover {
    background-color: #c62828;
    color: #ffffff;
}

QWidget#ClientCatNav {
    background-color: rgba(120, 100, 150, 0.06);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 10px;
}

QWidget#HomeBrandPane {
    background-color: transparent;
}

QWidget#HomeModsDrawer {
    background-color: transparent;
}

QWidget#HomeModsHost {
    background-color: transparent;
}

QLabel#HomeModCategory {
    color: #F1C22D;
    font-size: 12px;
    font-weight: 600;
}

QLabel#HomeModItem {
    color: #e6e0ee;
    font-size: 13px;
}

QPushButton#CatNavButton {
    text-align: left;
    padding: 12px 14px;
    border: none;
    border-radius: 0;
    background: transparent;
    font-size: 13px;
    color: #9990ab;
}

QPushButton#CatNavButton:hover {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
}

QPushButton#CatNavButton:checked {
    background-color: rgba(120, 100, 150, 0.12);
    color: #F1C22D;
    border-left: 3px solid #7c5cc4;
}

QProgressBar#BottomProgress {
    background-color: rgba(120, 100, 150, 0.10);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 4px;
    text-align: center;
    color: #e6e0ee;
    min-height: 22px;
}

QProgressBar#BottomProgress::chunk {
    background-color: #F1C22D;
    border-radius: 3px;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 8px;
    padding: 8px;
    min-height: 20px;
    selection-background-color: #7c5cc4;
}

QComboBox {
    background-color: rgba(120, 100, 150, 0.10);
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.18);
    border-radius: 8px;
    padding: 7px 32px 7px 10px;
    min-height: 18px;
    selection-background-color: #7c5cc4;
}

QComboBox:hover {
    border-color: #F1C22D;
}

QComboBox:on {
    border-color: #F1C22D;
    background-color: rgba(124, 92, 196, 0.18);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(__CHEVRON_DOWN__);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #100d0c;
    color: #e6e0ee;
    border: 1px solid rgba(150, 131, 158, 0.2);
    border-radius: 8px;
    outline: none;
    padding: 4px;
    selection-background-color: #4a2f7a;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
}

QCheckBox {
    spacing: 10px;
    color: #e6e0ee;
    min-height: 24px;
    padding: 2px 0;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid rgba(150, 131, 158, 0.25);
    border-radius: 4px;
    background: rgba(120, 100, 150, 0.10);
}

QCheckBox::indicator:checked {
    background-color: #F1C22D;
    border-color: #F1C22D;
}

QProgressBar {
    background-color: rgba(120, 100, 150, 0.10);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 4px;
    text-align: center;
    color: #e6e0ee;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #F1C22D;
    border-radius: 3px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #181412;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(150, 131, 158, 0.35);
    border-radius: 5px;
    min-height: 30px;
}

QListWidget, QTreeWidget, QTableWidget {
    background-color: rgba(120, 100, 150, 0.06);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 8px;
    color: #e6e0ee;
    outline: none;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #4a2f7a;
}

QStatusBar {
    background-color: #100d0c;
    color: #9990ab;
    border-top: 1px solid rgba(150, 131, 158, 0.15);
}

QTabWidget::pane {
    border: 1px solid rgba(150, 131, 158, 0.15);
    background: rgba(120, 100, 150, 0.06);
}

QTabBar::tab {
    background: rgba(120, 100, 150, 0.10);
    color: #9990ab;
    padding: 8px 16px;
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-bottom: none;
}

QTabBar::tab:selected {
    color: #F1C22D;
    background: #181412;
}

QMessageBox {
    background-color: #100d0c;
}

/* Launch countdown (ravencraft.io) */
QWidget#LaunchCountdown QLabel#CountdownTitle {
    color: #9990ab;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

QFrame#CountCell {
    background-color: rgba(120, 100, 150, 0.08);
    border: 1px solid rgba(150, 131, 158, 0.15);
    border-radius: 10px;
}

QLabel#CountNum {
    color: #F1C22D;
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
}

QLabel#CountLabel {
    color: #9990ab;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#CountdownLive {
    color: #F1C22D;
    font-size: 16px;
    font-weight: 700;
}
